# Copiez ces variables dans votre environnement (ne commitez jamais une vraie clé)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
JWT_SECRET=remplacez-par-une-longue-chaine-aleatoire-de-32-caracteres-minimum
ADMIN_PASSWORD=admin123
# Chiffrement des numéros de CIN (32 octets en Base64) : openssl rand -base64 32
CIN_ENCRYPTION_KEY=
# Validité des liens de téléchargement du rapport (minutes)
RAPPORT_LIEN_MINUTES=10
# Adresse du site (lien des e-mails de réinitialisation)
FRONT_URL=http://localhost:4200
# Envoi des e-mails (facultatif ; sans SMTP le lien est écrit dans les logs)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
MAIL_FROM=no-reply@limtic.local
# Limite de requêtes POST sensibles par minute et par IP
RATE_LIMIT_PER_MINUTE=10
